# ===================================================================
# BarBar Platform — Production Environment Configuration
# Stack: Next.js (Vercel) + FastAPI ASR (Render) + PostgreSQL (Neon)
# ===================================================================

# -------------------------------------------------------------------
# 1. Neon Serverless PostgreSQL Database
# -------------------------------------------------------------------
# Obtain this from your Neon Console (https://console.neon.tech):
# Example: postgresql://username:password@ep-cool-cloud-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://user:password@ep-xyz-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# Explicit SSL enforcement (Neon requires SSL):
DB_SSL=true

# Local / Self-hosted alternative (if running locally):
# DATABASE_URL=postgres://localhost:5432/barbar
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=barbar
# DB_USER=postgres
# DB_PASSWORD=postgres

# -------------------------------------------------------------------
# 2. Python FastAPI ASR & NLP Backend (Render.com)
# -------------------------------------------------------------------
# Unified URL for both browser WebSockets and server-side API requests:
NEXT_PUBLIC_PYTHON_BACKEND_URL=https://barbar-backend.onrender.com

# (Optional) Override only if server-side calls use a different private/internal network URL:
# PYTHON_BACKEND_URL=https://barbar-backend.onrender.com

# For local development:
# PYTHON_BACKEND_URL=http://127.0.0.1:8000
# NEXT_PUBLIC_PYTHON_BACKEND_URL=http://127.0.0.1:8000

# -------------------------------------------------------------------
# 3. Render.com Python Microservice Settings (Set in Render Dashboard)
# -------------------------------------------------------------------
# PYTHON_VERSION=3.11.9
# WHISPER_MODEL=small   # Options: 'small' (recommended for Armenian ASR), 'base', 'tiny'
# CORS_ORIGINS=*        # Or specific Vercel domain: https://your-project.vercel.app
# HF_TOKEN=             # Optional: Hugging Face personal access token for higher rate limits
